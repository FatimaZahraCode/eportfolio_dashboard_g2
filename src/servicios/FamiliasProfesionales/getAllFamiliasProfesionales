
function getAllFamiliasProfesionales() {
   return fetch('https://mocki.io/v1/61ba7146-867a-41d8-a096-9e278b2474ae')
      .then((response) => {
         return (response.json())
      }).then((data) => {
         console.log("1. DATOS CRUDOS DE LA API familias profesionales:", data);
        return data.familias || [];
      }).catch((error) => {
         console.error("FETCH ERROR:", error);
         return ([])
      })
}export default getAllFamiliasProfesionales